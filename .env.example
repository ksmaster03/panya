# คั่นด้วย , · "key" ใช้ได้ทุก container · "key@container" ผูกกับ container เดียว
PANYA_API_KEYS=change-me
PANYA_PORT=6800
PANYA_HOST=127.0.0.1

SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=panya

# เปลี่ยนโมเดลต้องเปลี่ยน DIM ให้ตรง และใช้ collection ใหม่ (เวกเตอร์เดิมใช้ร่วมไม่ได้)
PANYA_EMBED_MODEL=Xenova/multilingual-e5-small
PANYA_EMBED_DIM=384

# จัดอันดับซ้ำด้วยโมเดลตัวเล็ก (ไม่เขียนหรือแก้ข้อความ): แม่นขึ้นและรู้จักไม่ตอบดีขึ้น แลกกับเวลาค้นที่เพิ่มขึ้นและ RAM ราว 0.7 GB
# 1 = เปิด · PANYA_RERANK_TOP = จำนวนผู้สมัครอันดับต้นที่จัดอันดับซ้ำ (น้อยลง = เร็วขึ้น)
PANYA_RERANK=0
PANYA_RERANK_TOP=10
