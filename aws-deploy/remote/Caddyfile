# Cloudflare อยู่หน้าเสมอ (security group เปิดเฉพาะ IP ของ Cloudflare)
# :443 ใบรับรองที่ Caddy ออกเอง ใช้กับโหมด SSL "Full" ของ Cloudflare · :80 ใช้กับโหมด "Flexible"
# ถ้าโซนเป็น "Full (strict)" ต้องใช้ Origin Certificate ของ Cloudflare แทน tls internal
{
	auto_https off
	admin off
}

(site) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy panya:6800
}

https://{$DOMAIN}:443 {
	tls internal
	import site
}

http://:80 {
	import site
}
